// Shared by every Apple platform. Never commit a team ID, signing identity or provisioning profile here.
// To sign for a device, create Configuration/Local.xcconfig (gitignored) with `TEAM_ID = <your team ID>`;
// to build under your own team, also override PRODUCT_BUNDLE_IDENTIFIER there (an app ID belongs to one team).
TEAM_ID=

PRODUCT_NAME=Current
PRODUCT_BUNDLE_IDENTIFIER=com.skeksik.current

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

#include? "Local.xcconfig"
